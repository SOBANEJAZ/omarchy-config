# Personal shell aliases (append to ~/.bashrc)
alias settings='nvim ~/.config/hypr/'
alias rust='cd ~/Projects/'
alias zed='zeditor'

# Ethernet-backed Wi-Fi hotspot controls (backed by ~/.local/bin/omarchy-hotspot)
alias hotspot-on='omarchy-hotspot on'
alias hotspot-off='omarchy-hotspot off'
alias hotspot-new-name='omarchy-hotspot rename'
alias hotspot-new-pin='omarchy-hotspot password'
alias hotspot-status='omarchy-hotspot status'
alias hotspot-setup='omarchy-hotspot setup'
